*.cookie
*.cookies
cookies*.json
storage_state*.json
*.har

# Python
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/

# Editors / OS
.DS_Store
